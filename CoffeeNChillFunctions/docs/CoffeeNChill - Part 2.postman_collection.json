    {
      "name": "Orders (Part 2)",
      "item": [
        {
          "name": "1. Place Order (Queue Producer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "pm.collectionVariables.set('orderId', 'ORD-' + now.getTime());",
                  "pm.collectionVariables.set('orderTimestamp', now.toISOString());",
                  "pm.collectionVariables.set('orderDate', now.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order accepted and queued (2xx)', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "pm.test('Responds quickly (queue placement only, under 2000 ms)', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"{{orderId}}\",\n  \"CustomerName\": \"Thato Gumede\",\n  \"SelectedItemSKUs\": [\"COF-001\", \"MUF-002\"],\n  \"TotalPrice\": 78.5,\n  \"OrderTimestamp\": \"{{orderTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "queue"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Place Invalid Order (missing OrderId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid payload rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CustomerName\": \"Thato Gumede\",\n  \"TotalPrice\": 78.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "queue"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Order Status (early, in lifecycle)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the queue-triggered function time to pick up the message.",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order found in Orders table (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is a valid lifecycle stage', function () {",
                  "    const stages = ['Received', 'Preparing', 'Ready', 'Collected'];",
                  "    pm.expect(stages).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderDate}}/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderDate}}",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. List All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array containing the placed order', function () {",
                  "    const orders = pm.response.json();",
                  "    pm.expect(orders).to.be.an('array');",
                  "    pm.expect(orders.map(function (o) { return o.orderId; })).to.include(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "5. Get Order Status (after processing = Collected)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The simulated lifecycle takes about 15 seconds in total.",
                  "setTimeout(function () {}, 16000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order found in Orders table (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order reached final status Collected', function () { pm.expect(pm.response.json().status).to.eql('Collected'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
