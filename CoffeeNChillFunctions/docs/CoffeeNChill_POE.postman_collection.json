        {
          "name": "Place order on queue",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "pm.collectionVariables.set('orderId', 'ORD-' + now.getTime());",
                  "pm.collectionVariables.set('orderTimestamp', now.toISOString());",
                  "pm.collectionVariables.set('orderDate', now.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order accepted and queued (2xx)', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "pm.test('Responds quickly (queue placement only, under 3000 ms)', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "queue"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerName\": \"Thato Gumede\",\n  \"selectedItemSKUs\": [\n    \"COF-001\",\n    \"MUF-002\"\n  ],\n  \"totalPrice\": 78.5,\n  \"orderTimestamp\": \"{{orderTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Track order by id (after short wait)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Give the queue-triggered function time to process the message.",
                  "setTimeout(function () {}, 3000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order found (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Status is a valid lifecycle stage', function () {",
                  "    const stages = ['Received', 'Preparing', 'Ready', 'Collected'];",
                  "    const s = pm.response.json().status;",
                  "    pm.expect(stages).to.include(s);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderDate}}/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderDate}}",
                "{{orderId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
